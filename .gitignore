# ──────────────────────────────────────────────────────────────────────────────
# Dream Planet Referral Campaign — .gitignore
#
# Regenerable build outputs and duplicates are excluded here.
# See REPO_ARTIFACT_CLEANUP.md for the full audit rationale.
# ──────────────────────────────────────────────────────────────────────────────

# ── Root-level duplicate gz archives ─────────────────────────────────────────
# These are exact duplicates of extracted_scenes/Scene1scene2.gz and
# extracted_scenes/Scene3Scene4.gz — removed to avoid tracking 107 MB twice.
/Scene1scene2.gz
/Scene3Scene4.gz

# ── Extracted-scenes gz archives (authoritative snapshots — now untracked) ───
# Both archives are snapshots of the two predecessor Replit workspaces. All
# required content is already extracted and tracked under extracted_scenes/.
# No build or validation script references these archives.
# Removed from Git tracking 2026-08-05 (git rm --cached). See REPO_ARTIFACT_CLEANUP.md.
/extracted_scenes/Scene1scene2.gz
/extracted_scenes/Scene3Scene4.gz

# ── Extracted tar blobs ───────────────────────────────────────────────────────
# Raw tar archives extracted from the .gz files above. Re-extract with:
#   gzip -dc extracted_scenes/Scene1scene2.gz > extracted_scenes/Scene1scene2
#   gzip -dc extracted_scenes/Scene3Scene4.gz > extracted_scenes/Scene3Scene4
/extracted_scenes/Scene1scene2
/extracted_scenes/Scene3Scene4

# ── Temporary build workspaces ────────────────────────────────────────────────
# Generated by build_master.sh (uses tmp_dp_master_build/) and the old
# build_visual_review.sh (used tmp_dp_build/). Fully regenerable.
/tmp_dp_master_build/
/tmp_dp_build/
/tmp_dp_master_v2_build/
/tmp_dp_master_v3_build/
/tmp_dp_master_v5_build/

# ── VisualReview exports ──────────────────────────────────────────────────────
# Higher-bitrate preview renders generated by build_visual_review.sh.
# Not canonical deliverables — regenerate with: ./build_visual_review.sh
DreamPlanet_Master_v1_VisualReview.mp4
DreamPlanet_Master_v1_VisualReview_no_audio.mp4

# ── Pre-QA-fix archive ────────────────────────────────────────────────────────
# Superseded masters from before the Scene 2→3 blank-white-gap fix (Aug 2026).
# Documented in replit.md "Final master QA". Not needed for any rebuild.
*/_archive_pre_qa_fix/

# ── Browser capture intermediates ─────────────────────────────────────────────
# WebM captures and concat manifests generated by the scene3 capture workflow.
# Regenerable by re-running the browser capture process.
extracted_scenes/Scene3Scene4_contents/Replit-Design-Project/artifacts/dream-planet-scene3/captured/*.webm
extracted_scenes/Scene3Scene4_contents/Replit-Design-Project/artifacts/dream-planet-scene3/captured/master_concat.txt

# ── Node / pnpm ───────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
dist/
.cache/replit/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

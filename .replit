externalPort = 5000

[[ports]]
localPort = 7654
externalPort = 3002

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 23915
externalPort = 3000

[[ports]]
localPort = 24448
externalPort = 3001

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Scene 5 Preview"

[[workflows.workflow]]
name = "Scene 5 Preview"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node /home/runner/workspace/scene5_player/server.mjs"
waitForPort = 5000
